{
  "name": "@jujulego/tasks",
  "version": "3.0.0-alpha.11",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": "github:Jujulego/tasks",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "build": "yarn run build:esm && yarn run build:types",
    "build:esm": "swc src -d dist --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:types": "tsc --project tests"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.3",
    "kyrielle": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@jujulego/vite-plugin-swc": "1.2.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@swc/cli": "0.8.0",
    "@swc/core": "1.15.11",
    "@types/node": "24.10.13",
    "@typescript-eslint/utils": "8.55.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/eslint-plugin": "1.6.9",
    "eslint": "9.39.2",
    "jiti": "2.6.1",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "packageManager": "yarn@4.12.0"
}
