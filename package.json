{
  "name": "@jujulego/tasks",
  "version": "3.0.0-alpha.3",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jujulego/tasks"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "build": "yarn run build:esm && yarn run build:types",
    "build:esm": "swc src -d dist --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:types": "tsc --project tests"
  },
  "dependencies": {
    "@kyrielle/logger": "^2.0.0",
    "@swc/helpers": "^0.5.3",
    "kyrielle": "^2.7.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@jujulego/vite-plugin-swc": "1.2.0",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@swc/cli": "0.7.8",
    "@swc/core": "1.13.20",
    "@types/node": "22.18.10",
    "@typescript-eslint/utils": "8.46.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/eslint-plugin": "1.3.18",
    "eslint": "9.37.0",
    "jiti": "2.6.1",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "7.1.9",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "packageManager": "yarn@4.10.3"
}
